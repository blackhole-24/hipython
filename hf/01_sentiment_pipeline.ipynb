   "outputs": [],
   "source": [
    "from transformers import pipeline\n",
    "\n",
    "pipe = pipeline(\n",
    "    \"sentiment-analysis\",\n",
    "    model=\"distilbert/distilbert-base-uncased-finetuned-sst-2-english\",\n",
    "    device=0\n",
    ")\n",
    "\n",
    "result = pipe(\"I really enjoyed this class.\")\n",
    "print(result)"
